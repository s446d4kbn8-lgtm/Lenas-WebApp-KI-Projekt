# ─── Datenbank ──────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/messageboard"

# Nur für docker-compose relevant:
POSTGRES_PASSWORD="changeme"

# ─── Sicherheits-Secrets ─────────────────────────────────────────────────────
# Generieren mit: openssl rand -base64 32
JWT_SECRET="aendern-sie-diesen-wert-openssl-rand-base64-32"
CSRF_SECRET="aendern-sie-diesen-wert-openssl-rand-base64-32"

# ─── Admin-Zugangsdaten (für Seed-Skript) ────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="starkes-passwort-hier-eintragen"

# ─── Next.js ─────────────────────────────────────────────────────────────────
NODE_ENV="production"
